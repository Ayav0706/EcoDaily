<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EconoDaily — {{ newsletter.date }}</title>
  <style>
    body { margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, Helvetica, sans-serif; }
    table { border-collapse: collapse; }
    a { color: #2563eb; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .header-table { background-color: #1a1a2e; }
    .header-title { color: #ffffff; font-size: 28px; font-weight: bold; margin: 0; padding: 0; }
    .header-date { color: #a5b4fc; font-size: 14px; margin: 8px 0 0 0; }
    .section-header { font-size: 18px; font-weight: bold; color: #1f2937; margin: 0; padding: 6px 12px; border-radius: 4px; }
    .badge-macro { background-color: #dbeafe; color: #2563eb; }
    .badge-meso  { background-color: #d1fae5; color: #059669; }
    .badge-micro { background-color: #fee2e2; color: #dc2626; }
    .card { background-color: #f9fafb; margin: 8px 0; padding: 14px 16px; }
    .card-macro { border-left: 4px solid #2563eb; }
    .card-meso  { border-left: 4px solid #059669; }
    .card-micro { border-left: 4px solid #dc2626; }
    .card-title { font-size: 15px; font-weight: bold; color: #111827; margin: 0 0 8px 0; }
    .card-summary { font-size: 14px; color: #374151; margin: 0 0 8px 0; line-height: 1.5; }
    .card-why { font-size: 13px; color: #6b7280; font-style: italic; margin: 0 0 8px 0; line-height: 1.4; }
    .card-source { font-size: 12px; color: #9ca3af; }
    .index-section { background-color: #f8fafc; padding: 12px 24px; border-bottom: 1px solid #e5e7eb; }
    .index-title { font-size: 13px; font-weight: bold; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 8px 0; }
    .index-item { font-size: 14px; color: #374151; margin: 4px 0; }
    .footer-text { font-size: 11px; color: #9ca3af; line-height: 1.6; }
    .divider { height: 1px; background-color: #e5e7eb; }
  </style>
</head>
<body>
<!-- Outer wrapper -->
<table width="100%" bgcolor="#f4f4f4" cellpadding="0" cellspacing="0" border="0" role="presentation">
  <tr>
    <td align="center" style="padding: 20px 10px;">
      <!-- Inner content table -->
      <table width="600" bgcolor="#ffffff" cellpadding="0" cellspacing="0" border="0" role="presentation" style="max-width:600px;width:100%;">

        <!-- HEADER -->
        <tr>
          <td class="header-table" bgcolor="#1a1a2e" align="center" style="padding: 32px 24px 28px;">
            <p class="header-title">🗞️ EconoDaily</p>
            <p class="header-date">{{ newsletter.date }}</p>
          </td>
        </tr>

        <!-- INDEX SECTION -->
        <tr>
          <td class="index-section" style="padding: 16px 24px; background-color: #f8fafc; border-bottom: 1px solid #e5e7eb;">
            <p class="index-title">En este boletín</p>
            {% for level in newsletter.levels %}
            <p class="index-item">{{ level.emoji }} <strong>{{ level.label }}</strong></p>
            {% endfor %}
          </td>
        </tr>

        <!-- CONTENT SECTIONS -->
        {% for level in newsletter.levels %}
        <!-- Level: {{ level.level }} -->
        <tr>
          <td style="padding: 20px 24px 8px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr>
                <td>
                  <span class="section-header badge-{{ level.level }}"
                        style="display:inline-block; padding:6px 12px; border-radius:4px;">
                    {{ level.emoji }} {{ level.label }}
                  </span>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        {% for item in level.items[:3] %}
        <tr>
          <td style="padding: 4px 24px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
                   class="card card-{{ level.level }}"
                   style="background-color:#f9fafb; padding:14px 16px; margin:8px 0;">
              <tr>
                <td>
                  <p class="card-title">{{ item.title | truncate(120) }}</p>
                  <p class="card-summary">{{ item.summary | truncate(300) }}</p>
                  {% if item.why_it_matters %}
                  <p class="card-why"><strong>Por qué importa:</strong> {{ item.why_it_matters | truncate(200) }}</p>
                  {% endif %}
                  <p class="card-source">
                    Fuente: <a href="{{ item.url }}" target="_blank">{{ item.source }}</a>
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% else %}
        <tr>
          <td style="padding: 4px 24px 12px;">
            <p style="color:#9ca3af; font-size:13px; font-style:italic;">No hay noticias disponibles para este nivel.</p>
          </td>
        </tr>
        {% endfor %}

        <tr>
          <td style="padding: 8px 24px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
              <tr><td class="divider" style="height:1px; background-color:#e5e7eb;"></td></tr>
            </table>
          </td>
        </tr>
        {% endfor %}

        <!-- FOOTER -->
        <tr>
          <td align="center" style="padding: 20px 24px 28px; background-color: #f9fafb;">
            <p class="footer-text">
              Boletín generado automáticamente por EconoDaily.<br />
              Generado: {{ newsletter.generated_at }}<br />
              Fuentes: IMF, World Bank, BIS, OCDE, CEPAL, BID, AmericaEconomía, BCE, El Universo, El Comercio, Primicias.<br />
              Este correo es informativo. Los resúmenes son generados por IA y pueden contener errores.
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
</body>
</html>
